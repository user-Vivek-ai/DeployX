# ==============================================================================
# DeployX Platform - Environment Configuration Template
# ==============================================================================
# All keys below are optional. When omitted or set to placeholders, DeployX
# runs in High-Fidelity Simulation / Demo Mode with realistic sample data
# and clear UI indicators.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. AI Model Providers (Adapter Pattern)
# Valid options: "auto" | "mock" | "openai" | "anthropic" | "gemini"
# ------------------------------------------------------------------------------
AI_PROVIDER=auto

# OpenAI Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini Configuration (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. Payments (Stripe Integration - Test Mode Recommended First)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_here
PAYMENTS_MODE=test

# ------------------------------------------------------------------------------
# 3. OTP Verification Services (Email / SMS)
# Valid providers: "demo" | "twilio" | "resend"
# ------------------------------------------------------------------------------
OTP_PROVIDER=demo
TWILIO_ACCOUNT_SID=AC_placeholder_sid
TWILIO_AUTH_TOKEN=placeholder_auth_token
TWILIO_SERVICE_SID=VA_placeholder_verify_service_sid

# Resend for Email OTP (Optional)
RESEND_API_KEY=re_placeholder_api_key
OTP_SENDER_EMAIL=verify@yourdomain.com

# ------------------------------------------------------------------------------
# 4. Deployment Simulation / Live Hosting Adapter
# Valid providers: "local" | "vercel" | "custom_webhook"
# ------------------------------------------------------------------------------
DEPLOYMENT_PROVIDER=local
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx
